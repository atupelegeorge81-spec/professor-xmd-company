import type OpenAI from "openai";
import { AGENTS } from "./agents";

export interface AgendaItem {
  index: number;
  item: string;
  owners: string[];
}

export interface ScopeLock {
  objective: string;
  deliverable: string;
  requirements: string[];
  exclusions: string[];
  relevant_agents: string[];
}

export interface AgendaResult {
  understanding: string;
  scope: ScopeLock;
  items: AgendaItem[];
}

const SAFE_EXCLUSIONS = [
  "Do not invent unrelated product features, payments, marketing, legal work, integrations, databases, authentication, or infrastructure unless the CEO explicitly requires them.",
];

function clean(value: unknown): string {
  return typeof value === "string" ? value.trim() : "";
}

function validAgents(values: unknown): string[] {
  const ids = new Set(AGENTS.map((a) => a.id));

  if (!Array.isArray(values)) return [];

  return Array.from(
    new Set(
      values
        .map((v) => String(v))
        .filter((v) => ids.has(v)),
    ),
  );
}

function parseObject(raw: string): any {
  const cleaned = raw.replace(/```json|```/gi, "").trim();
  const match = cleaned.match(/\{[\s\S]*\}/);

  if (!match) {
    throw new Error("Scope model returned no JSON object");
  }

  return JSON.parse(match[0]);
}

function normalizeScope(value: any): ScopeLock {
  return {
    objective: clean(value?.objective),
    deliverable: clean(value?.deliverable),

    requirements: Array.isArray(value?.requirements)
      ? value.requirements
          .map((x: unknown) => clean(x))
          .filter(Boolean)
          .slice(0, 12)
      : [],

    exclusions:
      Array.isArray(value?.exclusions)
        ? value.exclusions
            .map((x: unknown) => clean(x))
            .filter(Boolean)
            .slice(0, 12)
        : [],

    relevant_agents: validAgents(value?.relevant_agents),
  };
}

async function buildScopeLock(
  client: OpenAI,
  model: string,
  project: string,
): Promise<ScopeLock> {
  try {
    const r = await client.chat.completions.create({
      model,
      messages: [
        {
          role: "system",
          content:
            `You are Optimus, the Project Manager and scope-control chair.

Your first job is to understand EXACTLY what the CEO requested.

Create a strict SCOPE LOCK as JSON only:

{
  "objective": "string",
  "deliverable": "string",
  "requirements": ["string"],
  "exclusions": ["string"],
  "relevant_agents": ["pm","designer","frontend","backend","qa"]
}

RULES:
1. objective = the CEO's real primary goal.
2. deliverable = exactly what must be produced.
3. requirements = only explicit requirements or things directly necessary to fulfill the request.
4. exclusions = unrelated work that must NOT be invented.
5. relevant_agents = only agents genuinely needed.
6. A narrow request MUST remain narrow.
7. NEVER assume every project needs payments, marketing, legal, database, authentication, deployment, or full product architecture.
8. If the CEO asks for animations, focus on animations.
9. If the CEO asks for UI, focus on UI.
10. If the CEO asks for code, focus on the requested code.
11. Do not transform a small task into a complete business/product plan.
12. Output JSON only.`,
        },
        {
          role: "user",
          content: `CEO REQUEST:\n${project}`,
        },
      ],
      temperature: 0.2,
      max_tokens: 700,
    });

    const scope = normalizeScope(
      parseObject(r.choices?.[0]?.message?.content || ""),
    );

    if (!scope.objective || !scope.deliverable) {
      throw new Error(
        "Scope lock missing objective or deliverable",
      );
    }

    if (scope.relevant_agents.length === 0) {
      scope.relevant_agents = ["pm", "qa"];
    }

    if (scope.exclusions.length === 0) {
      scope.exclusions = [...SAFE_EXCLUSIONS];
    }

    return scope;
  } catch (err) {
    console.warn(
      `[BoardRoom] Scope lock failed: ${
        err instanceof Error ? err.message : String(err)
      }`,
    );

    return {
      objective: `Fulfill exactly this CEO request: ${project}`,
      deliverable: project,
      requirements: [],
      exclusions: [...SAFE_EXCLUSIONS],
      relevant_agents: ["pm", "qa"],
    };
  }
}

function buildUnderstanding(scope: ScopeLock): string {
  return [
    `Objective: ${scope.objective}`,
    `Deliverable: ${scope.deliverable}`,
    `Requirements: ${
      scope.requirements.length
        ? scope.requirements.join("; ")
        : "Only what is necessary to fulfill the CEO request."
    }`,
    `Relevant agents: ${
      scope.relevant_agents.join(", ")
    }`,
  ].join(" ");
}

function unrelated(
  item: string,
  project: string,
  scope: ScopeLock,
): boolean {
  const text = item.toLowerCase();

  const allowedContext = [
    project,
    scope.objective,
    scope.deliverable,
    ...scope.requirements,
  ]
    .join(" ")
    .toLowerCase();

  const unrelatedGroups = [
    ["payment", "payments", "malipo", "mpesa", "stripe", "checkout"],
    ["marketing", "advertising", "ads", "campaign"],
    ["legal", "compliance", "sheria"],
    ["database", "sql", "mongodb", "postgres"],
    ["authentication", "auth", "login", "signup", "password"],
  ];

  for (const group of unrelatedGroups) {
    const itemMentions = group.some((word) =>
      text.includes(word),
    );

    if (!itemMentions) continue;

    const requestMentions = group.some((word) =>
      allowedContext.includes(word),
    );

    if (!requestMentions) return true;
  }

  return false;
}

function validateAgenda(
  items: AgendaItem[],
  project: string,
  scope: ScopeLock,
): AgendaItem[] {
  const relevant = new Set(scope.relevant_agents);

  return items
    .filter(
      (x) =>
        x &&
        typeof x.item === "string" &&
        x.item.trim(),
    )
    .filter(
      (x) =>
        !unrelated(
          x.item,
          project,
          scope,
        ),
    )
    .map((x, i) => {
      const owners = Array.from(
        new Set(
          (Array.isArray(x.owners) ? x.owners : [])
            .map((o) => String(o))
            .filter((o) => relevant.has(o)),
        ),
      ).slice(0, 3);

      return {
        index: i + 1,
        item: x.item.trim(),
        owners:
          owners.length > 0
            ? owners
            : Array.from(relevant).slice(0, 3),
      };
    })
    .slice(0, 8);
}

async function generateScopedAgenda(
  client: OpenAI,
  model: string,
  project: string,
  scope: ScopeLock,
): Promise<AgendaItem[]> {
  const r = await client.chat.completions.create({
    model,
    messages: [
      {
        role: "system",
        content:
          `You are Optimus, chair of a Board Room.

Generate ONLY the agenda required to fulfill the CEO request.

THE SCOPE LOCK IS AUTHORITATIVE.

Every agenda item MUST directly contribute to:
- the objective,
- the deliverable,
- or an explicit requirement.

HARD RULES:
- Do NOT broaden scope.
- Do NOT use a generic product checklist.
- Do NOT invent payments.
- Do NOT invent marketing.
- Do NOT invent legal/compliance.
- Do NOT invent authentication.
- Do NOT invent database work.
- Do NOT invent deployment.
- Do NOT invent unrelated integrations.
- A narrow request may need only ONE agenda item.
- A design/animation request must stay focused on design/animation.
- Use only relevant agents from the scope lock.

Return ONLY:

[
  {
    "item": "specific work item",
    "owners": ["agent_id"]
  }
]

Valid owners:
pm, designer, frontend, backend, qa`,
      },
      {
        role: "user",
        content:
          `CEO REQUEST:\n${project}\n\n` +
          `SCOPE LOCK:\n${JSON.stringify(
            scope,
            null,
            2,
          )}`,
      },
    ],
    temperature: 0.2,
    max_tokens: 700,
  });

  const raw = (r.choices?.[0]?.message?.content || "")
    .replace(/```json|```/gi, "")
    .trim();

  const match = raw.match(/\[[\s\S]*\]/);

  if (!match) {
    throw new Error(
      "Agenda model returned no JSON array",
    );
  }

  const arr = JSON.parse(match[0]);

  const ids = new Set(AGENTS.map((a) => a.id));

  return (Array.isArray(arr) ? arr : [])
    .filter(
      (x: any) =>
        x &&
        typeof x.item === "string" &&
        x.item.trim(),
    )
    .slice(0, 8)
    .map((x: any, i: number) => ({
      index: i + 1,
      item: String(x.item).trim(),
      owners: Array.isArray(x.owners)
        ? Array.from(
            new Set<string>(
              x.owners
                .map((o: any) => String(o))
                .filter(
                  (o: string) =>
                    ids.has(o) &&
                    scope.relevant_agents.includes(o),
                ),
            ),
          ).slice(0, 3)
        : [],
    }));
}

export async function generateAgenda(
  client: OpenAI,
  model: string,
  project: string,
): Promise<AgendaResult> {
  const scope = await buildScopeLock(
    client,
    model,
    project,
  );

  const understanding =
    buildUnderstanding(scope);

  try {
    const rawItems =
      await generateScopedAgenda(
        client,
        model,
        project,
        scope,
      );

    const items = validateAgenda(
      rawItems,
      project,
      scope,
    );

    if (items.length > 0) {
      return {
        understanding,
        scope,
        items,
      };
    }

    throw new Error(
      "Agenda validation rejected all items",
    );
  } catch (err) {
    console.warn(
      `[BoardRoom] Scoped agenda failed; using SAFE CEO-request fallback: ${
        err instanceof Error ? err.message : String(err)
      }`,
    );

    return {
      understanding,
      scope,
      items: [
        {
          index: 1,
          item: `Execute the CEO-requested deliverable: ${project.trim()}`,
          owners:
            scope.relevant_agents.length > 0
              ? scope.relevant_agents.slice(0, 3)
              : ["pm", "qa"],
        },
      ],
    };
  }
}
