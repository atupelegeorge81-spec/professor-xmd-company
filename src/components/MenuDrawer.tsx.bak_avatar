import { AGENTS } from "@/lib/agents";
import { Avatar } from "./Avatar";

interface Props {
  open: boolean;
  view: string;
  reportsBadge: number;
  onClose: () => void;
  onSelect: (v: string) => void;
}

export function MenuDrawer({ open, view, reportsBadge, onClose, onSelect }: Props) {
  if (!open) return null;
  const go = (v: string) => {
    onSelect(v);
    onClose();
  };

  return (
    <div className="fixed inset-0 z-50 flex justify-end bg-background/70 backdrop-blur-sm" onClick={onClose}>
      <aside
        onClick={(e) => e.stopPropagation()}
        className="menu-right glass-strong flex h-full w-[86%] max-w-sm flex-col rounded-l-3xl"
      >
        <div className="flex items-center gap-3 border-b border-border px-5 py-4">
          <span className="avatar-frame" style={{ width: 40, height: 40 }}>
            <img src="/brand/logo.png" alt="PROFESSOR-XMD-COMPANY" width={80} height={80} className="avatar-img" />
          </span>
          <div className="min-w-0 flex-1">
            <p className="truncate font-display text-[14px] font-bold text-foreground">PROFESSOR-XMD</p>
            <p className="text-[11px] text-muted-foreground">Autonomous engineering company</p>
          </div>
          <button
            onClick={onClose}
            aria-label="Close menu"
            className="grid h-9 w-9 place-items-center rounded-xl text-muted-foreground transition hover:bg-secondary hover:text-foreground"
          >
            ✕
          </button>
        </div>

        <div className="scroll-thin flex-1 overflow-y-auto px-3 py-4">
          <p className="px-3 pb-2 text-[10px] font-bold uppercase tracking-[0.2em] text-muted-foreground">Workspace</p>
          <NavRow active={view === "board"} onClick={() => go("board")} icon="🏛️" label="Board Room" hint="5 agents debate your project" />
          <NavRow
            active={view === "reports"}
            onClick={() => go("reports")}
            icon="📑"
            label="Reports"
            hint="Swahili reports by Optimus"
            badge={reportsBadge}
          />

          <p className="px-3 pb-2 pt-5 text-[10px] font-bold uppercase tracking-[0.2em] text-muted-foreground">Agents</p>
          {AGENTS.map((a) => {
            const active = view === a.id;
            return (
              <button
                key={a.id}
                onClick={() => go(a.id)}
                className={`panel-hover mb-1.5 flex w-full items-center gap-3 rounded-2xl border px-3 py-2.5 text-left ${
                  active ? "border-primary/45 bg-secondary/70" : "border-transparent bg-secondary/25"
                }`}
              >
                <Avatar agent={a} size={38} />
                <span className="min-w-0 flex-1">
                  <span className="block truncate font-display text-[13.5px] font-semibold text-foreground">{a.name}</span>
                  <span className="block truncate text-[11px] text-muted-foreground">{a.role}</span>
                </span>
                <span className="h-1.5 w-1.5 rounded-full" style={{ background: a.accent }} />
              </button>
            );
          })}
        </div>
      </aside>
    </div>
  );
}

function NavRow({
  active,
  onClick,
  icon,
  label,
  hint,
  badge,
}: {
  active: boolean;
  onClick: () => void;
  icon: string;
  label: string;
  hint: string;
  badge?: number;
}) {
  return (
    <button
      onClick={onClick}
      className={`panel-hover mb-1.5 flex w-full items-center gap-3 rounded-2xl border px-3 py-2.5 text-left ${
        active ? "border-primary/45 bg-secondary/70" : "border-transparent bg-secondary/25"
      }`}
    >
      <span className="grid h-9 w-9 place-items-center rounded-xl bg-signal/10 text-[17px]">{icon}</span>
      <span className="min-w-0 flex-1">
        <span className="block truncate font-display text-[13.5px] font-semibold text-foreground">{label}</span>
        <span className="block truncate text-[11px] text-muted-foreground">{hint}</span>
      </span>
      {badge ? (
        <span className="rounded-full bg-primary px-2 py-0.5 text-[10px] font-bold text-primary-foreground">{badge}</span>
      ) : null}
    </button>
  );
}
