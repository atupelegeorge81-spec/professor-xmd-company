"use client";

import { useCallback, useRef, type ReactNode } from "react";
import {
  AssistantRuntimeProvider,
  type AppendMessage,
  type ThreadMessageLike,
  useExternalStoreRuntime,
} from "@assistant-ui/react";
import type { Agent } from "@/lib/agents";
import type { AgentEvent, LogEntry, UiMessage } from "@/lib/types";
import { readNdjson } from "@/lib/stream";

const nid = () => Math.random().toString(36).slice(2, 10);

interface Props {
  agent: Agent;
  messages: UiMessage[];
  setMessages: React.Dispatch<React.SetStateAction<UiMessage[]>>;
  busy: boolean;
  setBusy: (busy: boolean) => void;
  addLog: (type: LogEntry["type"], message: string) => void;
  setUsage: (u: Record<string, { requests: number; tokens: number }>) => void;
  children: ReactNode;
}

function toAssistantMessage(
  message: UiMessage,
  createdAt: Date,
): ThreadMessageLike {
  const sourceParts = message.sources.map((source, index) => ({
    type: "source" as const,
    sourceType: "url" as const,
    id: `${message.id}-source-${index}`,
    url: source.url,
    title: source.title,
    status: { type: "complete" as const },
  }));

  return {
    id: message.id,
    role: message.role === "agent" ? "assistant" : "user",
    content: [
      {
        type: "text" as const,
        text: message.content || "",
      },
      ...sourceParts,
    ],
    createdAt,
    ...(message.role === "agent"
      ? {
          status:
            message.phase === "error"
              ? {
                  type: "incomplete" as const,
                  reason: "error" as const,
                }
              : message.phase === "done"
                ? {
                    type: "complete" as const,
                    reason: "stop" as const,
                  }
                : {
                    type: "running" as const,
                  },
          metadata: {
            custom: {
              xmdPhase: message.phase,
              xmdHasThinking: Boolean(message.thinking),
              xmdThinking: message.thinking,
              xmdQuery: message.query ?? "",
              xmdSearchError: message.searchError ?? "",
              xmdSources: message.sources ?? [],
              xmdError: message.error ?? "",
            },
          },
        }
      : {}),
  };
}

export function AssistantAgentRuntime({
  agent,
  messages,
  setMessages,
  busy,
  setBusy,
  addLog,
  setUsage,
  children,
}: Props) {
  const messagesRef = useRef(messages);
  messagesRef.current = messages;

  const createdAtRef = useRef(new Map<string, Date>());

  const convertMessage = useCallback(
    (message: UiMessage): ThreadMessageLike => {
      let createdAt = createdAtRef.current.get(message.id);

      if (!createdAt) {
        createdAt = new Date();
        createdAtRef.current.set(message.id, createdAt);
      }

      return toAssistantMessage(message, createdAt);
    },
    [],
  );

  const runAgent = useCallback(
    async ({
      prompt,
      history,
      agentMessageId,
      appendUserMessage,
    }: {
      prompt: string;
      history: Array<{
        role: "user" | "assistant";
        content: string;
      }>;
      agentMessageId: string;
      appendUserMessage?: UiMessage;
    }) => {
      setBusy(true);

      const agentMsg: UiMessage = {
        id: agentMessageId,
        role: "agent",
        agentId: agent.id,
        content: "",
        thinking: "",
        sources: [],
        phase: "thinking",
      };

      setMessages((current) => {
        if (appendUserMessage) {
          return [...current, appendUserMessage, agentMsg];
        }

        return current.map((message) =>
          message.id === agentMessageId ? agentMsg : message,
        );
      });

      const ctrl = new AbortController();

      const patch = (
        id: string,
        fn: (message: UiMessage) => UiMessage,
      ) => {
        setMessages((current) =>
          current.map((message) =>
            message.id === id ? fn(message) : message,
          ),
        );
      };

      try {
        const res = await fetch("/api/agent", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            agentId: agent.id,
            prompt,
            messages: history,
          }),
          signal: ctrl.signal,
        });

        await readNdjson<AgentEvent>(
          res,
          (event) => {
            switch (event.type) {
              case "thinking":
                patch(agentMsg.id, (message) => ({
                  ...message,
                  phase: "thinking",
                }));
                break;

              case "search":
                patch(agentMsg.id, (message) => ({
                  ...message,
                  phase: "searching",
                  query: event.query,
                }));
                break;

              case "sources":
                patch(agentMsg.id, (message) => ({
                  ...message,
                  sources: event.sources,
                  phase: "answering",
                }));
                break;

              case "search_error":
                patch(agentMsg.id, (message) => ({
                  ...message,
                  searchError: event.message,
                  phase: "answering",
                }));
                break;

              case "token":
                patch(agentMsg.id, (message) => ({
                  ...message,
                  content: message.content + event.text,
                  phase: "answering",
                }));
                break;

              case "usage":
                setUsage({
                  [agent.id]: {
                    requests: event.sessionRequests,
                    tokens: event.totalTokens,
                  },
                });
                break;

              case "log":
                addLog(event.entry.type, event.entry.message);
                break;

              case "done":
                patch(agentMsg.id, (message) => ({
                  ...message,
                  phase: "done",
                }));
                break;

              case "error":
                patch(agentMsg.id, (message) => ({
                  ...message,
                  phase: "error",
                  error: event.message,
                }));
                break;
            }
          },
          ctrl.signal,
        );
      } catch (error) {
        if ((error as Error)?.name !== "AbortError") {
          patch(agentMsg.id, (message) => ({
            ...message,
            phase: "error",
            error:
              (error as Error)?.message || "Connection failed",
          }));
        }
      } finally {
        setBusy(false);
      }
    },
    [addLog, agent.id, setBusy, setMessages, setUsage],
  );

  const onNew = useCallback(
    async (message: AppendMessage) => {
      const prompt = message.content
        .filter((part) => part.type === "text")
        .map((part) => part.text)
        .join("")
        .trim();

      if (
        !prompt ||
        messagesRef.current.some(
          (item) =>
            item.role === "agent" &&
            item.phase !== "done" &&
            item.phase !== "error",
        )
      ) {
        return;
      }

      const currentMessages = messagesRef.current;

      const history = currentMessages
        .filter(
          (item) =>
            item.phase === "done" &&
            item.content.trim(),
        )
        .map((item) => ({
          role:
            item.role === "agent"
              ? ("assistant" as const)
              : ("user" as const),
          content: item.content,
        }));

      const userMsg: UiMessage = {
        id: nid(),
        role: "user",
        content: prompt,
        thinking: "",
        sources: [],
        phase: "done",
      };

      await runAgent({
        prompt,
        history,
        agentMessageId: nid(),
        appendUserMessage: userMsg,
      });
    },
    [runAgent],
  );

  const onReload = useCallback(
    async (parentId: string | null) => {
      if (!parentId || busy) return;

      const currentMessages = messagesRef.current;
      const parentIndex = currentMessages.findIndex(
        (message) => message.id === parentId,
      );

      if (parentIndex < 0) return;

      const parent = currentMessages[parentIndex];

      if (parent.role !== "user" || !parent.content.trim()) {
        return;
      }

      const nextMessage = currentMessages[parentIndex + 1];

      if (!nextMessage || nextMessage.role !== "agent") {
        return;
      }

      const history = currentMessages
        .slice(0, parentIndex)
        .filter(
          (item) =>
            item.phase === "done" &&
            item.content.trim(),
        )
        .map((item) => ({
          role:
            item.role === "agent"
              ? ("assistant" as const)
              : ("user" as const),
          content: item.content,
        }));

      await runAgent({
        prompt: parent.content,
        history,
        agentMessageId: nextMessage.id,
      });
    },
    [busy, runAgent],
  );

  const runtime = useExternalStoreRuntime({
    messages,
    convertMessage,
    onNew,
    onReload,
    isRunning: busy,
  });

  return (
    <AssistantRuntimeProvider runtime={runtime}>
      {children}
    </AssistantRuntimeProvider>
  );
}
