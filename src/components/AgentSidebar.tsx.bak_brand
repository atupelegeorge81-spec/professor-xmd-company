import type { Agent } from "@/lib/agents";

interface Props {
  agents: Agent[];
  activeId: string;
  onSelect: (id: string) => void;
  onReset: () => void;
  busy: boolean;
}

export function AgentSidebar({ agents, activeId, onSelect, onReset, busy }: Props) {
  return (
    <aside className="flex h-full w-[300px] shrink-0 flex-col border-r border-white/10 bg-black/40 backdrop-blur-xl">
      <div className="flex items-center justify-between px-5 pb-4 pt-5">
        <div className="flex items-center gap-2.5">
          <span className="relative flex h-8 w-8 items-center justify-center">
            <span className="absolute inset-0 rounded-lg bg-gradient-to-br from-[#4285F4] via-[#34A853] to-[#EA4335] opacity-80 blur-[6px]" />
            <span className="relative grid h-8 w-8 place-items-center rounded-lg bg-gradient-to-br from-[#4285F4] via-[#8b5cf6] to-[#EA4335] text-[13px] font-bold text-white">
              AI
            </span>
          </span>
          <div>
            <p className="text-[14px] font-semibold leading-tight text-white">AI Team Room</p>
            <p className="flex items-center gap-1.5 text-[11px] leading-tight text-zinc-500">
              <span className="h-1.5 w-1.5 rounded-full bg-emerald-400" />
              · Timu ya Agents 5 · 24/7
            </p>
          </div>
        </div>
      </div>

      <button
        onClick={onReset}
        disabled={busy}
        className="mx-4 mb-3 flex items-center justify-center gap-2 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-[13px] font-medium text-zinc-300 transition hover:bg-white/10 disabled:opacity-40"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
          <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
          <path d="M3 3v5h5" />
        </svg>
        Mchezo mpya
      </button>

      <div className="px-4 pb-2 text-[11px] font-medium uppercase tracking-[0.14em] text-zinc-600">
        Agents · timu yako
      </div>

      <div className="flex-1 space-y-1.5 overflow-y-auto px-3 pb-4">
        {agents.map((a) => {
          const active = a.id === activeId;
          return (
            <button
              key={a.id}
              onClick={() => onSelect(a.id)}
              disabled={busy}
              className={`group relative flex w-full items-center gap-3 rounded-2xl border px-3 py-2.5 text-left transition disabled:opacity-70 ${
                active
                  ? "border-white/20 bg-white/[0.09] shadow-[0_8px_30px_rgba(66,133,244,0.12)]"
                  : "border-transparent bg-white/[0.02] hover:border-white/10 hover:bg-white/[0.06]"
              }`}
            >
              <span
                className={`grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-gradient-to-br text-lg ${a.gradient} ${
                  active ? "ring-2 ring-white/20" : ""
                }`}
              >
                {a.emoji}
              </span>
              <span className="min-w-0 flex-1">
                <span className="flex items-center gap-2">
                  <span className="truncate text-[14px] font-semibold text-white">{a.name}</span>
                  <span className="rounded-md bg-white/10 px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wide text-zinc-300">
                    {a.chip}
                  </span>
                </span>
                <span className="block truncate text-[11.5px] text-zinc-400">{a.tagline}</span>
              </span>
              <span
                className={`relative flex h-2 w-2 shrink-0 rounded-full ${
                  active ? "bg-emerald-400" : "bg-zinc-600"
                }`}
              >
                {active && (
                  <span className="absolute inset-0 animate-ping rounded-full bg-emerald-400 opacity-60" />
                )}
              </span>
            </button>
          );
        })}
      </div>

      <div className="border-t border-white/10 px-5 py-3 text-[11px] text-zinc-600">
        Powered by Groq · Qwen3.6 · SearXNG
      </div>
    </aside>
  );
}
