"use client";
import { useState } from "react";
import { getAgent } from "@/lib/agents";
import type { LogEntry } from "@/lib/types";

interface UsageData { [k: string]: { requests: number; tokens: number } | undefined }

interface Props {
  logs: LogEntry[];
  roomLabel: string;
  usage?: UsageData | null;
  onClear: () => void;
}

export function LogsPopup({ logs, roomLabel, usage, onClear }: Props) {
  const [isOpen, setIsOpen] = useState(false);
  const handleCopy = () => {
    navigator.clipboard.writeText(logs.map(l => `[${l.timestamp}] [${l.type.toUpperCase()}] ${l.message}`).join("\n"));
  };
  const getIcon = (t: LogEntry["type"]) =>
    ({ success: "✅", error: "❌", warning: "⚠️", api: "⚡", search: "🔍", system: "⚙️", info: "ℹ️" }[t] || "ℹ️");
  const getColor = (t: LogEntry["type"]) =>
    ({ success: "text-[#7fd49a]", error: "text-red-400", warning: "text-amber-300", api: "text-[#8ab4f8]", search: "text-sky-300", system: "text-zinc-400", info: "text-zinc-400" }[t] || "text-zinc-400");

  const usageEntries = usage
    ? (Object.entries(usage).filter(([k, v]) => k !== "total" && v) as [string, { requests: number; tokens: number }][])
    : [];
  const total = usage?.total;

  return (
    <>
      <button
        onClick={() => setIsOpen(o => !o)}
        className="fixed bottom-20 right-3 z-40 rounded-full bg-gradient-to-r from-[#4285F4] to-[#34A853] px-3 py-2 text-[11px] font-bold text-white shadow-lg"
      >
        📋 Logs ({logs.length})
      </button>
      {isOpen && (
        <div className="fixed inset-x-2 bottom-32 z-40 mx-auto max-h-[60vh] max-w-3xl overflow-hidden rounded-2xl border border-white/15 bg-[#0a0a12]/95 backdrop-blur-xl">
          <div className="flex items-center justify-between border-b border-white/10 px-4 py-2.5">
            <div className="flex items-center gap-2">
              <span className="text-[12px] font-bold text-white">System Logs</span>
              <span className="rounded bg-white/10 px-1.5 py-0.5 text-[10px] text-zinc-400">📍 {roomLabel}</span>
            </div>
            <div className="flex gap-2">
              <button onClick={handleCopy} className="rounded-lg bg-white/5 px-2 py-1 text-[10px] text-zinc-300 hover:bg-white/10">Copy</button>
              <button onClick={onClear} className="rounded-lg bg-red-500/10 px-2 py-1 text-[10px] text-red-300 hover:bg-red-500/20">Clear</button>
              <button onClick={() => setIsOpen(false)} className="rounded-lg bg-white/5 px-2 py-1 text-[10px] text-zinc-300 hover:bg-white/10">✕</button>
            </div>
          </div>
          {usageEntries.length > 0 && (
            <div className="grid grid-cols-2 gap-1.5 border-b border-white/10 bg-white/[0.03] px-4 py-2 sm:grid-cols-3">
              {usageEntries.map(([id, u]) => {
                const a = getAgent(id);
                return (
                  <div key={id} className="rounded-lg bg-black/30 px-2 py-1">
                    <div className="text-[10px] font-semibold text-white">{a?.emoji} {a?.name || id}</div>
                    <div className="text-[9px] text-zinc-400">{u.requests} req · {(u.tokens / 1000).toFixed(1)}k tok</div>
                  </div>
                );
              })}
              {total && (
                <div className="col-span-2 rounded-lg bg-[#4285F4]/10 px-2 py-1 sm:col-span-3">
                  <div className="text-[10px] font-semibold text-[#8ab4f8]">TOTAL: {total.requests} requests · {(total.tokens / 1000).toFixed(1)}k tokens</div>
                </div>
              )}
            </div>
          )}
          <div className="scroll-thin max-h-[45vh] overflow-y-auto px-4 py-2">
            {logs.length === 0 ? (
              <div className="py-6 text-center text-[11px] text-zinc-500">Hakuna logs bado.</div>
            ) : (
              logs.map(l => (
                <div key={l.id} className="flex gap-2 border-b border-white/[0.04] py-1 text-[10.5px] leading-4">
                  <span className="shrink-0 text-zinc-500">{l.timestamp}</span>
                  <span className="shrink-0">{getIcon(l.type)}</span>
                  <span className={getColor(l.type)}>{l.message}</span>
                </div>
              ))
            )}
          </div>
        </div>
      )}
    </>
  );
}
