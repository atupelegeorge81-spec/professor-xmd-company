"use client";
import { useEffect, useState } from "react";
import type { Agent } from "@/lib/agents";
import type { UiMessage } from "@/lib/types";
import { Markdown } from "./Markdown";

function domainOf(url: string): string {
  try {
    return new URL(url).hostname.replace(/^www\./, "");
  } catch {
    return url;
  }
}

function PhaseBadge({ phase }: { phase: UiMessage["phase"] }) {
  if (phase === "done") return null;
  const map: Record<UiMessage["phase"], { label: string; color: string }> = {
    thinking: { label: "Thinking…", color: "text-[#8ab4f8]" },
    searching: { label: "Searching web…", color: "text-amber-300" },
    answering: { label: "Responding…", color: "text-emerald-300" },
    done: { label: "", color: "" },
    error: { label: "Error", color: "text-red-300" },
  };
  const m = map[phase];
  return (
    <span className={`flex items-center gap-1.5 text-[11px] font-medium ${m.color}`}>
      {(phase === "thinking" || phase === "searching" || phase === "answering") && (
        <span className="flex gap-0.5">
          <span className="h-1 w-1 animate-bounce rounded-full bg-current [animation-delay:-0.3s]" />
          <span className="h-1 w-1 animate-bounce rounded-full bg-current [animation-delay:-0.15s]" />
          <span className="h-1 w-1 animate-bounce rounded-full bg-current" />
        </span>
      )}
      {m.label}
    </span>
  );
}

function ThoughtBlock({
  text,
  busy,
  show,
  onToggle,
}: {
  text: string;
  busy: boolean;
  show: boolean;
  onToggle: () => void;
}) {
  const [copied, setCopied] = useState(false);

  const handleCopy = () => {
    navigator.clipboard.writeText(text);
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  };

  return (
    <div className="overflow-hidden rounded-2xl border border-white/10 bg-black/40">
      <button
        onClick={onToggle}
        className="flex w-full items-center gap-2 px-3.5 py-2.5 text-left text-[12.5px] font-semibold text-zinc-300 transition hover:bg-white/[0.03]"
      >
        <span className="grid h-5 w-5 place-items-center rounded-md bg-gradient-to-br from-[#8b5cf6]/40 to-[#4285F4]/40 text-[13px]">
          ✦
        </span>
        <span className="flex-1">Thought process</span>
        <span className="flex gap-0.5">
          <span className="h-1 w-1 animate-bounce rounded-full bg-[#a78bfa] [animation-delay:-0.3s]" />
          <span className="h-1 w-1 animate-bounce rounded-full bg-[#a78bfa] [animation-delay:-0.15s]" />
          <span className="h-1 w-1 animate-bounce rounded-full bg-[#a78bfa]" />
        </span>
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          strokeWidth="2.2"
          strokeLinecap="round"
          strokeLinejoin="round"
          className={`text-zinc-500 transition-transform ${show ? "rotate-180" : ""}`}
        >
          <path d="m6 9 6 6 6-6" />
        </svg>
      </button>
      {show && (
        <div className="border-t border-white/[0.06] px-3.5 py-3">
          <div className="mb-2 flex items-center justify-between">
            {busy && (
              <div className="text-[11px] font-medium uppercase tracking-wide text-[#a78bfa]/70">
                model ina fikira…
              </div>
            )}
            <button
              onClick={(e) => {
                e.stopPropagation();
                handleCopy();
              }}
              className="ml-auto flex items-center gap-1.5 rounded-md bg-white/5 px-2 py-1 text-[11px] text-zinc-400 transition hover:bg-white/10 hover:text-white"
            >
              {copied ? (
                <>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M20 6 9 17l-5-5"/></svg>
                  Copied!
                </>
              ) : (
                <>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                  Copy Thought
                </>
              )}
            </button>
          </div>
          <div className="whitespace-pre-wrap text-[13px] leading-6 text-zinc-400">{text}</div>
        </div>
      )}
    </div>
  );
}

function SearchPanel({ message }: { message: UiMessage }) {
  return (
    <div className="overflow-hidden rounded-2xl border border-white/10 bg-gradient-to-br from-[#4285F4]/[0.12] to-[#34A853]/[0.08] p-3.5">
      <div className="flex items-center gap-3">
        <span className="relative grid h-9 w-9 place-items-center">
          <span className="search-ring absolute inset-0 rounded-full" />
          <span className="h-2.5 w-2.5 rounded-full bg-white" />
        </span>
        <div className="min-w-0 flex-1">
          <div className="flex items-center gap-1.5 text-[12px] font-semibold text-[#8ab4f8]">
            <span className="capitalize">Kutafuta web&nbsp;·&nbsp;</span>
            <span className="truncate font-medium text-white">“{message.query}”</span>
          </div>
          <div className="mt-1.5 h-1 overflow-hidden rounded-full bg-white/10">
            <span className="block h-full w-1/3 animate-[shimmer_1.1s_ease-in-out_infinite] rounded-full bg-gradient-to-r from-[#4285F4] via-[#34A853] to-[#EA4335]" />
          </div>
        </div>
      </div>
      {message.sources.length > 0 ? (
        <div className="mt-3 grid gap-2">
          {message.sources.map((s, i) => (
            <a
              key={`${s.url}-${i}`}
              href={s.url}
              target="_blank"
              rel="noreferrer"
              className="group flex items-start gap-3 rounded-xl border border-white/[0.06] bg-black/20 p-2.5 transition hover:bg-white/[0.05]"
            >
              <span className="grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-white/5">
                <img
                  src={`https://www.google.com/s2/favicons?domain=${domainOf(s.url)}&sz=64`}
                  alt=""
                  className="h-4 w-4"
                  loading="lazy"
                />
              </span>
              <span className="min-w-0 flex-1">
                <span className="block truncate text-[13px] font-semibold text-zinc-100 group-hover:text-white">
                  {s.title || domainOf(s.url)}
                </span>
                <span className="block truncate text-[11px] text-[#8ab4f8]/80">{domainOf(s.url)}</span>
                {s.content && (
                  <span className="mt-1 line-clamp-2 block text-[12px] leading-5 text-zinc-400">
                    {s.content}
                  </span>
                )}
              </span>
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                strokeWidth="2"
                strokeLinecap="round"
                strokeLinejoin="round"
                className="mt-1 shrink-0 text-zinc-600 transition group-hover:text-[#8ab4f8]"
              >
                <path d="M7 17 17 7" />
                <path d="M7 7h10v10" />
              </svg>
            </a>
          ))}
        </div>
      ) : (
        <div className="mt-3 flex items-center gap-2 text-[12px] text-zinc-400">
          <span className="h-1.5 w-1.5 animate-pulse rounded-full bg-amber-300" />
          search engines zinatafuta matokeo…
        </div>
      )}
      {message.searchError && (
        <div className="mt-2 text-[12px] text-red-300/90">
          Search hit shida: {message.searchError}
        </div>
      )}
    </div>
  );
}

function Avatar({ agent, busy }: { agent?: Agent; busy: boolean }) {
  return (
    <span className="relative grid h-9 w-9 shrink-0 place-items-center">
      <span className="absolute inset-0 rounded-2xl bg-gradient-to-br from-white/10 to-white/0 blur-[2px]" />
      <span
        className={`relative grid h-9 w-9 place-items-center rounded-2xl bg-gradient-to-br text-lg ${
          agent?.gradient ?? "from-[#4285F4] to-[#34A853]"
        }`}
      >
        {agent?.emoji ?? "🤖"}
      </span>
      {busy && (
        <span className="absolute -bottom-0.5 -right-0.5 h-3 w-3 rounded-full border-2 border-[#0b0b12] bg-emerald-400" />
      )}
    </span>
  );
}

export function MessageBubble({ message, agent }: { message: UiMessage; agent?: Agent }) {
  const busy =
    message.phase === "thinking" ||
    message.phase === "searching" ||
    message.phase === "answering";
  const [showThought, setShowThought] = useState(true);
  const [copiedResponse, setCopiedResponse] = useState(false);

  useEffect(() => {
    if (message.phase === "done") setShowThought(false);
  }, [message.phase]);

  const handleCopyResponse = () => {
    navigator.clipboard.writeText(message.content);
    setCopiedResponse(true);
    setTimeout(() => setCopiedResponse(false), 2000);
  };

  if (message.role === "user") {
    return (
      <div className="flex justify-end px-4">
        <div className="max-w-[80%] rounded-3xl rounded-br-lg border border-white/10 bg-gradient-to-br from-[#4285F4]/[0.22] to-[#8b5cf6]/[0.14] px-4 py-3 text-[15px] leading-7 text-white shadow-[0_10px_30px_rgba(66,133,244,0.15)]">
          <Markdown text={message.content} />
        </div>
      </div>
    );
  }

  return (
    <div className="flex gap-3 px-4">
      <Avatar agent={agent} busy={busy} />
      <div className="max-w-[82%] min-w-0 flex-1 space-y-2">
        <div className="flex flex-wrap items-center justify-between gap-2.5">
          <div className="flex flex-wrap items-center gap-2.5">
            <span className="text-[13px] font-semibold text-white">
              {agent?.name ?? "Agent"}
            </span>
            <span className="rounded-md bg-white/10 px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-zinc-400">
              {agent?.role ?? "AI"}
            </span>
            <PhaseBadge phase={message.phase} />
          </div>
          
          {/* Copy Response Button */}
          {message.phase === "done" && message.content && (
            <button
              onClick={handleCopyResponse}
              className="flex items-center gap-1.5 rounded-md bg-white/5 px-2 py-1 text-[11px] text-zinc-400 transition hover:bg-white/10 hover:text-white"
            >
              {copiedResponse ? (
                <>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M20 6 9 17l-5-5"/></svg>
                  Copied!
                </>
              ) : (
                <>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                  Copy Response
                </>
              )}
            </button>
          )}
        </div>

        {message.thinking && (
          <ThoughtBlock
            text={message.thinking}
            busy={busy}
            show={showThought}
            onToggle={() => setShowThought((s) => !s)}
          />
        )}
        {message.query && <SearchPanel message={message} />}
        {message.content && (
          <div className="rounded-3xl rounded-tl-md border border-white/10 bg-white/[0.04] px-4 py-3 backdrop-blur-md">
            <Markdown text={message.content} />
            {busy && (
              <span className="ml-0.5 inline-block h-4 w-[2px] animate-pulse bg-[#8ab4f8] align-middle" />
            )}
          </div>
        )}
        {message.phase === "error" && (
          <div className="rounded-2xl border border-red-400/20 bg-red-500/[0.08] px-4 py-3 text-[13px] text-red-200">
            {message.error || "Something went wrong — jaribu tena."}
          </div>
        )}
        {message.phase === "done" && !message.content && message.query && (
          <div className="text-[12px] text-zinc-500">
            Source zimeonyeshwa hapo juu. Chagua na uendelee.
          </div>
        )}
      </div>
    </div>
  );
}
