"use client";

import {
  ComposerPrimitive,
  MessagePrimitive,
  ThreadPrimitive,
} from "@assistant-ui/react";
import type { Agent } from "@/lib/agents";
import { AssistantAgentMessage } from "./AssistantAgentMessage";

interface Props {
  agent: Agent;
  busy?: boolean;
}

function AssistantUserMessage() {
  return (
    <MessagePrimitive.Root className="flex w-full justify-end">
      <div className="max-w-[86%] rounded-2xl rounded-br-md bg-primary/70 px-4 py-2.5 text-[14px] leading-6 text-primary-foreground shadow-[0_10px_30px_-14px_var(--primary)]">
        <MessagePrimitive.Parts
          components={{
            Text: ({ text }) => (
              <span className="whitespace-pre-wrap break-words">
                {text}
              </span>
            ),
          }}
        />
      </div>
    </MessagePrimitive.Root>
  );
}

export function AssistantAgentThread({
  agent,
}: Props) {
  const AssistantMessage = () => (
    <AssistantAgentMessage agent={agent} />
  );
  return (
    <div className="flex min-h-0 flex-1 flex-col">
      <ThreadPrimitive.Root className="flex min-h-0 flex-1 flex-col">
        <ThreadPrimitive.Viewport
          className="scroll-thin min-h-0 flex-1 overflow-y-auto [overflow-anchor:none]"
          autoScroll={false}
          scrollToBottomOnRunStart={false}
          scrollToBottomOnInitialize={true}
          scrollToBottomOnThreadSwitch={false}
        >
          <div className="mx-auto w-full max-w-3xl space-y-5 px-4 py-5">
            <ThreadPrimitive.Messages
              components={{
                UserMessage: AssistantUserMessage,
                AssistantMessage,
              }}
            />
          </div>
        </ThreadPrimitive.Viewport>

        <div className="mx-auto w-full max-w-3xl px-4 pb-4 pt-2">
          <ComposerPrimitive.Root className="glass-strong flex items-end gap-2 rounded-[26px] p-2 transition-shadow focus-within:ring-signal">
            <ComposerPrimitive.Input
              placeholder={`Ongea na ${agent.name}...`}
              submitMode="enter"
              className="min-h-10 max-h-40 flex-1 resize-none bg-transparent px-3 py-2.5 text-[14px] leading-5 text-foreground outline-none placeholder:text-muted-foreground"
            />

            <ComposerPrimitive.Send
              aria-label="Send message"
              className="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-signal text-primary-foreground shadow-[0_8px_24px_-12px_var(--primary)] transition-all hover:brightness-110 active:scale-95 disabled:pointer-events-none disabled:opacity-40"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                className="h-[17px] w-[17px]"
                aria-hidden="true"
              >
                <path
                  d="M12 19V5M6.5 10.5 12 5l5.5 5.5"
                  stroke="currentColor"
                  strokeWidth="2"
                  strokeLinecap="round"
                  strokeLinejoin="round"
                />
              </svg>
            </ComposerPrimitive.Send>
          </ComposerPrimitive.Root>
        </div>
      </ThreadPrimitive.Root>
    </div>
  );
}
