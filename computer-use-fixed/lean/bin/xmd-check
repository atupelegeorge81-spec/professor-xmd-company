#!/usr/bin/env python3
"""xmd-check URL — status · title · muda (badala ya browser kwa uhakiki rahisi)."""
import re, sys, time, urllib.request, urllib.error
if len(sys.argv) < 2: print("usage: xmd-check URL"); sys.exit(1)
u = sys.argv[1]; t0 = time.time()
try:
    r = urllib.request.urlopen(urllib.request.Request(u, headers={"User-Agent": "xmd"}), timeout=30)
    code, body = r.status, r.read(200_000).decode("utf-8", "replace")
except urllib.error.HTTPError as e:
    code, body = e.code, ""
except Exception as e:
    print(f"DOWN · {e}"); sys.exit(2)
m = re.search(r"<title[^>]*>(.*?)</title>", body, re.S | re.I)
print(f"{code} · title \"{(m.group(1).strip() if m else '-')[:80]}\" · {time.time()-t0:.2f}s · {len(body)} bytes")
sys.exit(0 if code < 400 else 1)
