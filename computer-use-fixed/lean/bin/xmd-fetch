#!/usr/bin/env python3
"""xmd-fetch URL — ukurasa kama maandishi safi (herufi ~3000; zima linahifadhiwa)."""
import html, os, re, sys, hashlib, urllib.request
if len(sys.argv) < 2: print("usage: xmd-fetch URL"); sys.exit(1)
url = sys.argv[1]
try:
    r = urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0 xmd"}), timeout=40)
    raw = r.read(3_000_000).decode(r.headers.get_content_charset() or "utf-8", "replace")
except Exception as e:
    print(f"fetch failed: {e}"); sys.exit(2)
t = re.search(r"<title[^>]*>(.*?)</title>", raw, re.S | re.I)
raw = re.sub(r"(?is)<(script|style|noscript|svg|head)[^>]*>.*?</\1>", " ", raw)
raw = re.sub(r"(?i)<br\s*/?>|</(p|div|li|h[1-6]|tr)>", "\n", raw)
txt = html.unescape(re.sub(r"<[^>]+>", " ", raw))
txt = "\n".join(" ".join(l.split()) for l in txt.splitlines() if l.strip())
d = os.environ.get("XMD_OUT_DIR", "/tmp/xmd-out"); os.makedirs(d, exist_ok=True)
p = os.path.join(d, "page-" + hashlib.md5(url.encode()).hexdigest()[:8] + ".txt")
open(p, "w").write(txt)
print(f"# {html.unescape(t.group(1).strip()) if t else url}\n{url} · {len(txt)} chars · full: {p}\n")
print(txt[:3000] + ("\n…[truncated]" if len(txt) > 3000 else ""))
